# Origin of the server hosting translation models/tokenizers (e.g., http://localhost:5500)
NEXT_PUBLIC_STORAGE_ORIGIN=

# Base path for model files - combined with ORIGIN (e.g., /v0.0.1)
NEXT_PUBLIC_STORAGE_BASE=

# Origin of the server hosting ONNX Runtime WASM - only set if different from STORAGE (e.g., http://localhost:3000)
NEXT_PUBLIC_JSEP_ORIGIN=

# Path for WASM files - combined with JSEP_ORIGIN (e.g., /storage/v0.0.1)
NEXT_PUBLIC_JSEP_PATHNAME=

# Allowed origins for CORS on /storage/ static assets - comma-separated (e.g., http://localhost:3000)
CORS_ALLOWED_ORIGINS=
